    "version": "0.2.0",
    "configurations": [
        {
            "name": "Chem R5 查看一轮决策",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/run.py",
            "args": ["r5", "inspect", "--task", "HPLC", "--round", "14"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/code/chemist_system",
                    "remoteRoot": "${workspaceFolder}/experiments/chemist_system"
                }
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}
